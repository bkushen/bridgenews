NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Edge/server-only. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional bearer token required only for manual/private Edge Function invocation.
INGEST_CRON_SECRET=

# Optional future AI enrichment. BridgeNews does not require AI to operate.
GEMINI_API_KEY=
GEMINI_CLASSIFICATION_MODEL=gemini-3.5-flash-lite
STORY_CLUSTER_THRESHOLD=0.86
PROCESS_CRON_SECRET=
